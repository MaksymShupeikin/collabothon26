# Copy to .env.local (dev) or .env (Docker on the VPS) and fill in. Never commit the real file.

# Study buddy (AI chat). Create a key in the Claude Console → Settings → API keys.
ANTHROPIC_API_KEY=
# Optional: override the model or the answer depth (low | medium | high).
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=low

# Progress is saved to .data/comdirect-edu-saves.json (no database needed).
# Optional: put the file somewhere else.
# COMDIRECT_MCP_DATA_FILE=/path/to/saves.json
